# ============================================================
# Storyboard-to-GIF Animator - Environment Variables Template
# ============================================================
# Copy this file to '.env' and fill in your actual API keys.
# NEVER commit your actual '.env' file to Git!

# Google Gemini API Key (Required for LLM storyboard generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face User Access Token (Optional: used for HF Inference API fallback)
# Obtain from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Image Generation Mode: 'local_diffusers' or 'hf_api' or 'mock'
# 'local_diffusers': uses local PyTorch + stabilityai/sd-turbo (GPU recommended)
# 'hf_api': uses Hugging Face Inference API (cloud-based, fast on CPU)
# 'mock': generates stylized placeholder story frames for offline testing/dry-runs
IMAGE_GEN_MODE=local_diffusers

# Similarity Threshold for BLIP caption vs shot prompt mismatch detection (0.0 to 1.0)
MISMATCH_THRESHOLD=0.35
